{
  "name": "futari-voice-desktop",
  "productName": "FutariVoice",
  "version": "1.0.0",
  "description": "なかまボイス Windows版",
  "author": "FutariVoice",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "app.futarivoice.desktop",
    "productName": "FutariVoice",
    "files": ["main.js", "preload.js", "offline.html", "config.json", "icon.ico"],
    "directories": { "output": "dist" },
    "protocols": [{ "name": "FutariVoice", "schemes": ["futarivoice"] }],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "FutariVoice-Setup.exe",
      "shortcutName": "なかまボイス",
      "uninstallDisplayName": "なかまボイス",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.0.12"
  }
}
